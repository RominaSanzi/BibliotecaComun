<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>true</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Divinf.Common.Sql\Divinf.Common.Sql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      DLL legacy de Loan que se compara contra la nueva implementacion.
      ANTES de correr los tests: copiar manualmente Loan1.Utils.dll a tests\refs\
      desde el bin\Debug del proyecto Utils de Loan.
    -->
    <Reference Include="Loan1.Utils" Condition="Exists('refs\Loan1.Utils.dll')">
      <HintPath>refs\Loan1.Utils.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
